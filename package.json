  },
  "bugs": {
    "url": "https://github.com/mravtechinfo/mSAS_v2/issues"
  },
  "private": false,
  "files": [
    "index.html",
    "apk-auditor/",
    "ipa-auditor/",
    "adb-auditor/",
    "about/",
