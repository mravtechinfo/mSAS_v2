  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mravtechinfo/mobile-security-auditor.git"
  },
  "bugs": {
    "url": "https://github.com/mravtechinfo/mobile-security-auditor/issues"
  },
  "private": false,
  "files": [
    "index.html",
    "apk-auditor/",
    "ipa-auditor/"
